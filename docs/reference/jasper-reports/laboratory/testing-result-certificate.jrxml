<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="testing-result-certificate"
              pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40"
              topMargin="50" bottomMargin="50">

    <style name="Title" isBold="true" fontName="DejaVu Sans" fontSize="18"/>
    <style name="Subtitle" fontName="DejaVu Sans" fontSize="12"/>
    <style name="SectionLabel" isBold="true" fontName="DejaVu Sans" fontSize="10"/>
    <style name="Header" isBold="true" fontName="DejaVu Sans" fontSize="9"/>
    <style name="Body" fontName="DejaVu Sans" fontSize="9"/>
    <style name="Small" fontName="DejaVu Sans" fontSize="8"/>
    <style name="Note" isItalic="true" fontName="DejaVu Sans" fontSize="7"/>

    <parameter name="certificateNumber" class="java.lang.String"/>
    <parameter name="sampleCode" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="projectName" class="java.lang.String"/>
    <parameter name="testingServiceName" class="java.lang.String"/>
    <parameter name="submittedAt" class="java.lang.String"/>
    <parameter name="submittedByName" class="java.lang.String"/>
    <parameter name="certificateDate" class="java.lang.String"/>
    <parameter name="laboranName" class="java.lang.String"/>
    <parameter name="customerSignatureName" class="java.lang.String"/>
    <parameter name="labSignatureName" class="java.lang.String"/>
    <parameter name="resultNotes" class="java.lang.String"/>
    <parameter name="contractNumber" class="java.lang.String"/>
    <parameter name="sampleUnit" class="java.lang.String"/>
    <parameter name="resultNumber" class="java.lang.String"/>
    <parameter name="berat" class="java.lang.String"/>
    <parameter name="luas" class="java.lang.String"/>
    <parameter name="retakan" class="java.lang.String"/>
    <parameter name="testingDate" class="java.lang.String"/>
    <parameter name="createdDate" class="java.lang.String"/>
    <parameter name="mutu" class="java.lang.String"/>
    <parameter name="produk" class="java.lang.String"/>
    <parameter name="LOGO" class="java.io.InputStream"/>

    <field name="name" class="java.lang.String"/>
    <field name="value" class="java.lang.String"/>
    <field name="method" class="java.lang.String"/>
    <field name="unit" class="java.lang.String"/>
    <field name="sop" class="java.lang.String"/>

    <title>
        <band height="130">
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Middle">
                <reportElement x="0" y="0" width="120" height="120">
                    <printWhenExpression><![CDATA[$P{LOGO} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="0" y="40" width="120" height="40">
                    <printWhenExpression><![CDATA[$P{LOGO} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[CAKRA ERP]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="5" width="415" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[LABORATORIUM TEKNIK SIPIL]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="23" width="415" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <text><![CDATA[UNIVERSITAS MULIA]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="44" width="415" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[CERTIFICATE OF TESTING]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="68" width="415" height="18"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <text><![CDATA[Test Result]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="86" width="415" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["No: " + ($P{certificateNumber} != null ? $P{certificateNumber} : "-")]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="118" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#000000"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="180">
            <!-- Sample Information Box -->
            <staticText>
                <reportElement x="0" y="0" width="515" height="14" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <text><![CDATA[SAMPLE INFORMATION]]></text>
            </staticText>
            <!-- Row 1 -->
            <staticText>
                <reportElement x="0" y="16" width="80" height="12"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <text><![CDATA[Sample Code:]]></text>
            </staticText>
            <textField>
                <reportElement x="80" y="16" width="170" height="12"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{sampleUnit} != null && !$P{sampleUnit}.isEmpty() && $P{sampleUnit} != "0" && $P{resultNumber} != null && !$P{resultNumber}.isEmpty()) ? "unit-" + $P{sampleUnit} + "-" + $P{resultNumber} : ($P{sampleCode} != null ? $P{sampleCode} : "-")]]></textFieldExpression>
