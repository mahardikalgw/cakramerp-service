    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="35" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[#]]></text>
            </staticText>
            <staticText>
                <reportElement x="35" y="0" width="115" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
