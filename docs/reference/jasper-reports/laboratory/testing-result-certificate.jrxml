                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{createdDate} != null && !$P{createdDate}.isEmpty() ? $P{createdDate} : "-"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="260" y="129" width="100" height="14"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
