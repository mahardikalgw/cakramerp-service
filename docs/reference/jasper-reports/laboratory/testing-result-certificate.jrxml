                <textFieldExpression><![CDATA[$P{retakan} != null && !$P{retakan}.isEmpty() ? $P{retakan} : "-"]]></textFieldExpression>
            </textField>

            <!-- Testing Information Section -->
            <staticText>
                <reportElement x="0" y="113" width="515" height="14" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
