                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <text><![CDATA[Berat (kg)]]></text>
            </staticText>
            <textField>
                <reportElement x="170" y="76" width="170" height="16"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{berat} != null && !$P{berat}.isEmpty() ? $P{berat} : "-"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="340" y="76" width="80" height="16"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <text><![CDATA[Luas (cm²)]]></text>
            </staticText>
            <textField>
                <reportElement x="420" y="76" width="95" height="16"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{luas} != null && !$P{luas}.isEmpty() ? $P{luas} : "-"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="93" width="170" height="16"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
