    <summary>
        <band height="300">
            <line>
                <reportElement x="0" y="5" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#000000"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="15" width="515" height="16"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[Test results are recorded as received. Any reproduction of this certificate requires prior written approval from the laboratory.]]></text>
            </staticText>
            <!-- Result Notes -->
            <textField isStretchWithOverflow="true">
                <reportElement style="Body" x="0" y="35" width="515" height="16"/>
                <textElement textAlignment="Left">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{resultNotes} != null && !$P{resultNotes}.isEmpty() ? "Notes: " + $P{resultNotes} : ""]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="55" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#999999"/>
                </graphicElement>
            </line>
            <!-- Signature blocks: 2 columns (Laboran + Customer) -->
            <staticText>
