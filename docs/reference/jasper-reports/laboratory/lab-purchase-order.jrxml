<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="lab-purchase-order"
              pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40"
              topMargin="50" bottomMargin="50">

    <style name="Title" fontName="DejaVu Sans" fontSize="18" isBold="true"/>
    <style name="Subtitle" fontName="DejaVu Sans" fontSize="12" />
    <style name="SectionLabel" fontName="DejaVu Sans" fontSize="10" isBold="true"/>
    <style name="Header" fontName="DejaVu Sans" fontSize="9" isBold="true"/>
    <style name="Body" fontName="DejaVu Sans" fontSize="9" />
    <style name="Small" fontName="DejaVu Sans" fontSize="8" />
    <style name="Note" fontName="DejaVu Sans" fontSize="7" isItalic="true"/>

    <parameter name="poNumber" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="customerAddress" class="java.lang.String"/>
    <parameter name="status" class="java.lang.String"/>
    <parameter name="orderDate" class="java.lang.String"/>
    <parameter name="requestNumber" class="java.lang.String"/>
    <parameter name="totalSamples" class="java.lang.String"/>
    <parameter name="authorizedByName" class="java.lang.String"/>
    <parameter name="LOGO" class="java.io.InputStream"/>

    <field name="serviceName" class="java.lang.String"/>
    <field name="sampleCode" class="java.lang.String"/>
    <field name="quantity" class="java.lang.String"/>

    <title>
        <band height="130">
            <!-- Logo (left) -->
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Middle">
                <reportElement x="0" y="0" width="120" height="120">
                    <printWhenExpression><![CDATA[$P{LOGO} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <!-- Logo fallback (text) -->
            <staticText>
                <reportElement x="0" y="40" width="120" height="40">
                    <printWhenExpression><![CDATA[$P{LOGO} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[CAKRA ERP]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="5" width="415" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[LABORATORIUM TEKNIK SIPIL]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="23" width="415" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <text><![CDATA[UNIVERSITAS MULIA]]></text>
            </staticText>
            <!-- Title -->
            <staticText>
                <reportElement x="100" y="44" width="415" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LABORATORY PURCHASE ORDER]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="68" width="415" height="18"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <text><![CDATA[Sample Testing Request Document]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="86" width="415" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["No: " + ($P{poNumber} != null ? $P{poNumber} : "-")]]></textFieldExpression>
            </textField>
            <!-- Top divider -->
            <line>
                <reportElement x="0" y="118" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#000000"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="100">
            <!-- Left column: Customer info -->
            <staticText>
                <reportElement x="0" y="5" width="80" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Customer:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="SectionLabel" x="0" y="20" width="240" height="16"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerName} != null ? $P{customerName} : "-"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="0" y="38" width="240" height="40"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerAddress} != null ? $P{customerAddress} : ""]]></textFieldExpression>
            </textField>
            <!-- Right column: PO meta -->
            <staticText>
                <reportElement x="300" y="5" width="100" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Request No:]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="5" width="115" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{requestNumber} != null ? $P{requestNumber} : "-"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="22" width="100" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[PO Date:]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="22" width="115" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{orderDate} != null ? $P{orderDate} : "-"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="39" width="100" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Status:]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="39" width="115" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{status} != null ? $P{status}.toUpperCase() : "-"]]></textFieldExpression>
            </textField>
            <!-- Header divider -->
            <line>
                <reportElement x="0" y="90" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#666666"/>
                </graphicElement>
            </line>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="35" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[#]]></text>
            </staticText>
            <staticText>
                <reportElement x="35" y="0" width="240" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <text><![CDATA[Service Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="275" y="0" width="160" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <text><![CDATA[Sample Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="0" width="80" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Quantity]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="0" y="0" width="35" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="35" y="0" width="240" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{serviceName} != null ? $F{serviceName} : ""]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="275" y="0" width="160" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{sampleCode} != null ? $F{sampleCode} : "-"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="435" y="0" width="80" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity} != null ? $F{quantity} : "0"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="0" y="10" width="515" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="210">
            <!-- Top divider -->
            <line>
                <reportElement x="0" y="5" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#000000"/>
                </graphicElement>
            </line>
            <!-- Total Samples -->
            <staticText>
                <reportElement x="300" y="15" width="135" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Samples:]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="15" width="80" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalSamples} != null ? $P{totalSamples} : "0"]]></textFieldExpression>
            </textField>
            <!-- Mid divider -->
            <line>
                <reportElement x="0" y="50" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#999999"/>
                </graphicElement>
            </line>
            <!-- Signature blocks -->
            <staticText>
                <reportElement x="20" y="85" width="220" height="16"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Authorized by Laboratory]]></text>
            </staticText>
            <staticText>
                <reportElement x="275" y="85" width="220" height="16"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Acknowledged by Customer]]></text>
            </staticText>
            <!-- Signature lines -->
            <line>
                <reportElement x="40" y="150" width="180" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.7" lineColor="#000000"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="295" y="150" width="180" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.7" lineColor="#000000"/>
                </graphicElement>
            </line>
            <textField>
                <reportElement x="20" y="153" width="220" height="14"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{authorizedByName} != null ? $P{authorizedByName} : "Lab Authorized"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="275" y="153" width="220" height="14"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerName} != null ? $P{customerName} : "Customer"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="20" y="170" width="220" height="14"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[Date: ____________________]]></text>
            </staticText>
            <staticText>
                <reportElement x="275" y="170" width="220" height="14"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[Date: ____________________]]></text>
            </staticText>
            <!-- Footer -->
            <line>
                <reportElement x="0" y="185" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="191" width="515" height="14"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="7" isItalic="true"/>
                </textElement>
                <text><![CDATA[This document is auto-generated by CakramERP Laboratory System]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
