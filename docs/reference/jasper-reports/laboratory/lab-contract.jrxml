<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="lab-contract"
              pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40"
              topMargin="50" bottomMargin="50" whenNoDataType="AllSectionsNoDetail">

    <style name="Title" isBold="true" fontName="DejaVu Sans" fontSize="18"/>
    <style name="Subtitle" fontName="DejaVu Sans" fontSize="12"/>
    <style name="SectionLabel" isBold="true" fontName="DejaVu Sans" fontSize="10"/>
    <style name="Header" isBold="true" fontName="DejaVu Sans" fontSize="9"/>
    <style name="Body" fontName="DejaVu Sans" fontSize="9"/>
    <style name="Small" fontName="DejaVu Sans" fontSize="8"/>
    <style name="Note" isItalic="true" fontName="DejaVu Sans" fontSize="7"/>

    <parameter name="contractNumber" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="customerAddress" class="java.lang.String"/>
    <parameter name="projectName" class="java.lang.String"/>
    <parameter name="projectLocation" class="java.lang.String"/>
    <parameter name="billingType" class="java.lang.String"/>
    <parameter name="totalQuota" class="java.lang.String"/>
    <parameter name="usedQuota" class="java.lang.String"/>
    <parameter name="remainingQuota" class="java.lang.String"/>
    <parameter name="baseAmount" class="java.lang.String"/>
    <parameter name="taxPercent" class="java.lang.String"/>
    <parameter name="taxAmount" class="java.lang.String"/>
    <parameter name="totalAmount" class="java.lang.String"/>
    <parameter name="generatedAt" class="java.lang.String"/>
    <parameter name="generatedByName" class="java.lang.String"/>
    <parameter name="customerSignatureName" class="java.lang.String"/>
    <parameter name="labSignatureName" class="java.lang.String"/>
    <parameter name="expiresAt" class="java.lang.String"/>
    <parameter name="isCash" class="java.lang.String">
        <defaultValueExpression><![CDATA["false"]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGO" class="java.io.InputStream"/>
    <parameter name="scopeOfTesting" class="java.lang.String"/>
    <parameter name="contractEstimation" class="java.lang.String"/>
    <parameter name="contractTempoDays" class="java.lang.String"/>
    <parameter name="downPaymentAmount" class="java.lang.String"/>
    <parameter name="dpDueDate" class="java.lang.String"/>
    <parameter name="paymentTerms" class="java.lang.String">
        <defaultValueExpression><![CDATA["Monthly per-sample billing on 25th of each month"]]></defaultValueExpression>
    </parameter>

    <parameter name="contractTerm" class="java.lang.String">
        <defaultValueExpression><![CDATA["180 days from signing"]]></defaultValueExpression>
    </parameter>

    <field name="serviceName" class="java.lang.String"/>
    <field name="sampleCode" class="java.lang.String"/>
    <field name="sampleQuantity" class="java.lang.String"/>
    <field name="unitPrice" class="java.lang.String"/>
    <field name="totalPrice" class="java.lang.String"/>

    <title>
        <band height="130">
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Middle">
                <reportElement x="0" y="0" width="120" height="120">
                    <printWhenExpression><![CDATA[$P{LOGO} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="0" y="40" width="120" height="40">
                    <printWhenExpression><![CDATA[$P{LOGO} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[CAKRA ERP]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="5" width="385" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[LABORATORIUM TEKNIK SIPIL]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="23" width="385" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <text><![CDATA[UNIVERSITAS MULIA]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="44" width="385" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LABORATORY CONTRACT]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="68" width="385" height="18"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <text><![CDATA[Testing Service Agreement]]></text>
            </staticText>
            <textField>
                <reportElement x="130" y="86" width="385" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["No: " + ($P{contractNumber} != null ? $P{contractNumber} : "-")]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="118" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#000000"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="100">
            <staticText>
                <reportElement x="0" y="5" width="80" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Customer:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="SectionLabel" x="0" y="20" width="240" height="16"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerName} != null ? $P{customerName} : "-"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="0" y="38" width="240" height="40"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerAddress} != null ? $P{customerAddress} : ""]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="5" width="100" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Project:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="400" y="5" width="115" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{projectName} != null ? $P{projectName} : "-"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="22" width="100" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Location:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="400" y="22" width="115" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{projectLocation} != null ? $P{projectLocation} : "-"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="39" width="100" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Billing Type:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="400" y="39" width="115" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{billingType} != null ? $P{billingType} : "-"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="90" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#666666"/>
                </graphicElement>
            </line>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="35" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[#]]></text>
            </staticText>
            <staticText>
                <reportElement x="35" y="0" width="200" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <text><![CDATA[Service Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="235" y="0" width="80" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <text><![CDATA[Sample Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="315" y="0" width="50" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="365" y="0" width="75" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Unit Price]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="0" width="75" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Price]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="0" y="0" width="35" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="35" y="0" width="200" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{serviceName} != null ? $F{serviceName} : ""]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="235" y="0" width="80" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{sampleCode} != null ? $F{sampleCode} : "-"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="315" y="0" width="50" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{sampleQuantity} != null ? $F{sampleQuantity} : "0"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="365" y="0" width="75" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($F{unitPrice} != null ? $F{unitPrice} : "0")]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="440" y="0" width="75" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($F{totalPrice} != null ? $F{totalPrice} : "0")]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="0" y="10" width="515" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="610">
            <line>
                <reportElement x="0" y="5" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#000000"/>
                </graphicElement>
            </line>
            <!-- Quota Section -->
            <staticText>
                <reportElement x="0" y="15" width="165" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Contract Quota Summary]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="36" width="150" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Quota]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="36" width="100" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[": " + ($P{totalQuota} != null ? $P{totalQuota} : "0")]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="54" width="150" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Used Quota]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="54" width="100" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[": " + ($P{usedQuota} != null ? $P{usedQuota} : "0")]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="72" width="150" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Remaining Quota]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="72" width="100" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[": " + ($P{remainingQuota} != null ? $P{remainingQuota} : "0")]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="98" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#999999"/>
                </graphicElement>
            </line>
            <!-- Financial Summary (contract billing only) -->
            <staticText>
                <reportElement x="0" y="108" width="165" height="16">
                    <printWhenExpression><![CDATA[!"true".equals($P{isCash})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Financial Summary]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="108" width="135" height="18">
                    <printWhenExpression><![CDATA[!"true".equals($P{isCash})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Base Amount:]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="108" width="80" height="18">
                    <printWhenExpression><![CDATA[!"true".equals($P{isCash})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($P{baseAmount} != null ? $P{baseAmount} : "0")]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="130" width="135" height="16">
                    <printWhenExpression><![CDATA[!"true".equals($P{isCash})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <text><![CDATA[Tax (PPN):]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="130" width="80" height="16">
                    <printWhenExpression><![CDATA[!"true".equals($P{isCash})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{taxPercent} != null ? $P{taxPercent} : "0") + "%"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="150" width="135" height="16">
                    <printWhenExpression><![CDATA[!"true".equals($P{isCash})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <text><![CDATA[Tax Amount:]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="150" width="80" height="16">
                    <printWhenExpression><![CDATA[!"true".equals($P{isCash})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($P{taxAmount} != null ? $P{taxAmount} : "0")]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="175" width="135" height="20">
                    <printWhenExpression><![CDATA[!"true".equals($P{isCash})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Amount:]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="175" width="80" height="20">
                    <printWhenExpression><![CDATA[!"true".equals($P{isCash})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($P{totalAmount} != null ? $P{totalAmount} : "0")]]></textFieldExpression>
            </textField>
            <!-- Down Payment row (always visible when downPaymentAmount is set) -->
            <staticText>
                <reportElement x="0" y="200" width="165" height="16">
                    <printWhenExpression><![CDATA[$P{downPaymentAmount} != null && !$P{downPaymentAmount}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Down Payment]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="200" width="135" height="18">
                    <printWhenExpression><![CDATA[$P{downPaymentAmount} != null && !$P{downPaymentAmount}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Down Payment Required:]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="200" width="80" height="18">
                    <printWhenExpression><![CDATA[$P{downPaymentAmount} != null && !$P{downPaymentAmount}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($P{downPaymentAmount} != null ? $P{downPaymentAmount} : "0")]]></textFieldExpression>
            </textField>
            <!-- DP due date note -->
            <textField>
                <reportElement x="0" y="220" width="515" height="20">
                    <printWhenExpression><![CDATA[$P{downPaymentAmount} != null && !$P{downPaymentAmount}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["* Down payment must be paid within 7 days (due: " + ($P{dpDueDate} != null ? $P{dpDueDate} : "-") + "). Contract activation upon payment confirmation."]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="245" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#999999"/>
                </graphicElement>
            </line>
            <!-- Scope of Testing -->
            <staticText>
                <reportElement x="0" y="262" width="200" height="16"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Scope of Testing]]></text>
            </staticText>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="0" y="280" width="515" height="50"/>
                <textElement textAlignment="Left" verticalAlignment="Top">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{scopeOfTesting} != null ? $P{scopeOfTesting} : "-"]]></textFieldExpression>
