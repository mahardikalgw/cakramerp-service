            <staticText>
                <reportElement x="100" y="5" width="415" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[LABORATORIUM TEKNIK SIPIL]]></text>
