            <staticText>
                <reportElement x="100" y="23" width="415" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <text><![CDATA[UNIVERSITAS MULIA]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="44" width="415" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[MONTHLY INVOICE]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="68" width="415" height="18"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <text><![CDATA[Contract Billing for Laboratory Services]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="86" width="415" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["No: " + ($P{invoiceNumber} != null ? $P{invoiceNumber} : "-")]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="118" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#000000"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="100">
            <staticText>
                <reportElement x="0" y="5" width="80" height="14"/>
