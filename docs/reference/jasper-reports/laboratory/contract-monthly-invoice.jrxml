                </textElement>
                <textFieldExpression><![CDATA[($P{billingPeriodStart} != null ? $P{billingPeriodStart} : "-") + " / " + ($P{billingPeriodEnd} != null ? $P{billingPeriodEnd} : "-")]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="90" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#666666"/>
                </graphicElement>
            </line>
