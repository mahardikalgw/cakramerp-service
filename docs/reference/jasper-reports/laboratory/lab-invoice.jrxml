            <!-- Signature lines -->
            <line>
                <reportElement x="40" y="175" width="180" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.7" lineColor="#000000"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="295" y="175" width="180" height="1"/>
                <graphicElement>
