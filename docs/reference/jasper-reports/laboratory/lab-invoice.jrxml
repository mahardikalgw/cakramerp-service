                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Metode Pembayaran:]]></text>
            </staticText>
            <staticText>
                <reportElement x="20" y="104" width="475" height="14"/>
                <textElement textAlignment="Left">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <text><![CDATA[// Transfer Virtual Account Mandiri — Laboratorium Universitas Mulia]]></text>
