                <textElement textAlignment="Left">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <text><![CDATA[// Bank Mandiri: 1490025855919 a.n. Universitas Mulia]]></text>
            </staticText>
            <line>
                <reportElement x="20" y="135" width="475" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </graphicElement>
            </line>
            <!-- Signature blocks -->
            <staticText>
