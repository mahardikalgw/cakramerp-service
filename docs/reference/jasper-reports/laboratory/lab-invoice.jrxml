<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="lab-invoice"
              pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40"
              topMargin="50" bottomMargin="50">

    <style name="Title" isBold="true" fontName="DejaVu Sans" fontSize="18"/>
    <style name="Subtitle" fontName="DejaVu Sans" fontSize="12"/>
    <style name="SectionLabel" isBold="true" fontName="DejaVu Sans" fontSize="10"/>
    <style name="Header" isBold="true" fontName="DejaVu Sans" fontSize="9"/>
    <style name="Body" fontName="DejaVu Sans" fontSize="9"/>
    <style name="Small" fontName="DejaVu Sans" fontSize="8"/>
    <style name="Note" isItalic="true" fontName="DejaVu Sans" fontSize="7"/>

    <parameter name="invoiceNumber" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="customerAddress" class="java.lang.String"/>
    <parameter name="status" class="java.lang.String"/>
    <parameter name="invoiceDate" class="java.lang.String"/>
    <parameter name="dueDate" class="java.lang.String"/>
    <parameter name="subtotal" class="java.lang.String"/>
    <parameter name="taxPercent" class="java.lang.String"/>
    <parameter name="taxAmount" class="java.lang.String"/>
    <parameter name="totalAmount" class="java.lang.String"/>
    <parameter name="authorizedByName" class="java.lang.String"/>
    <parameter name="LOGO" class="java.io.InputStream"/>

    <field name="description" class="java.lang.String"/>
    <field name="quantity" class="java.lang.String"/>
    <field name="unitPrice" class="java.lang.String"/>
    <field name="total" class="java.lang.String"/>

    <title>
        <band height="130">
            <!-- Logo (left) -->
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Middle">
                <reportElement x="0" y="0" width="120" height="120">
                    <printWhenExpression><![CDATA[$P{LOGO} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <!-- Logo fallback (text) -->
            <staticText>
                <reportElement x="0" y="40" width="120" height="40">
                    <printWhenExpression><![CDATA[$P{LOGO} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[CAKRA ERP]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="5" width="415" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[LABORATORIUM TEKNIK SIPIL]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="23" width="415" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <text><![CDATA[UNIVERSITAS MULIA]]></text>
            </staticText>
            <!-- Title -->
            <staticText>
                <reportElement x="100" y="44" width="415" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[INVOICE]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="68" width="415" height="18"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <text><![CDATA[Bill for Laboratory Services]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="86" width="415" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["No: " + ($P{invoiceNumber} != null ? $P{invoiceNumber} : "-")]]></textFieldExpression>
            </textField>
            <!-- Top divider -->
            <line>
                <reportElement x="0" y="118" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#000000"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="100">
            <!-- Left column: Bill To -->
            <staticText>
                <reportElement x="0" y="5" width="80" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Bill To:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="SectionLabel" x="0" y="20" width="240" height="16"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerName} != null ? $P{customerName} : "-"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="0" y="38" width="240" height="40"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{customerAddress} != null ? $P{customerAddress} : ""]]></textFieldExpression>
            </textField>
            <!-- Right column: Invoice meta -->
            <staticText>
                <reportElement x="300" y="5" width="100" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Invoice Date:]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="5" width="115" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{invoiceDate} != null ? $P{invoiceDate} : "-"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="22" width="100" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Due Date:]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="22" width="115" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dueDate} != null ? $P{dueDate} : "-"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="39" width="100" height="14"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Status:]]></text>
            </staticText>
            <textField>
                <reportElement x="400" y="39" width="115" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{status} != null ? $P{status}.toUpperCase() : "-"]]></textFieldExpression>
            </textField>
            <!-- Header divider -->
            <line>
                <reportElement x="0" y="90" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#666666"/>
                </graphicElement>
            </line>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="35" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[#]]></text>
            </staticText>
            <staticText>
                <reportElement x="35" y="0" width="220" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement x="255" y="0" width="50" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="305" y="0" width="100" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <text><![CDATA[Unit Price]]></text>
            </staticText>
            <staticText>
                <reportElement x="405" y="0" width="110" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="0" y="0" width="35" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="35" y="0" width="220" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph leftIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description} != null ? $F{description} : ""]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="255" y="0" width="50" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity} != null ? $F{quantity} : "0"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="305" y="0" width="100" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($F{unitPrice} != null ? $F{unitPrice} : "0")]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Body" x="405" y="0" width="110" height="25"/>
                <box>
                    <pen lineWidth="0.3" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($F{total} != null ? $F{total} : "0")]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="0" y="10" width="515" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="260">
            <!-- Top divider -->
            <line>
                <reportElement x="0" y="5" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#000000"/>
                </graphicElement>
            </line>
            <!-- Subtotal -->
            <staticText>
                <reportElement x="305" y="10" width="100" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <text><![CDATA[Subtotal:]]></text>
            </staticText>
            <textField>
                <reportElement x="405" y="10" width="110" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($P{subtotal} != null ? $P{subtotal} : "0")]]></textFieldExpression>
            </textField>
            <!-- PPN -->
            <textField>
                <reportElement x="305" y="28" width="100" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA["PPN (" + ($P{taxPercent} != null ? $P{taxPercent} : "11") + "%):"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="405" y="28" width="110" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($P{taxAmount} != null ? $P{taxAmount} : "0")]]></textFieldExpression>
            </textField>
            <!-- Grand total box -->
            <staticText>
                <reportElement x="305" y="48" width="100" height="22" mode="Opaque" backcolor="#F0F0F0"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#666666"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <text><![CDATA[Grand Total:]]></text>
            </staticText>
            <textField>
                <reportElement x="405" y="48" width="110" height="22" mode="Opaque" backcolor="#F0F0F0"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#666666"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                    <paragraph rightIndent="5"/>
                </textElement>
                <textFieldExpression><![CDATA["Rp " + ($P{totalAmount} != null ? $P{totalAmount} : "0")]]></textFieldExpression>
            </textField>
