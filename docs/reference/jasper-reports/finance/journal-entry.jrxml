<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="journal-entry"
              pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40"
              topMargin="50" bottomMargin="50">

    <style name="Title" isBold="true" fontName="DejaVu Sans" fontSize="18"/>
    <style name="Subtitle" fontName="DejaVu Sans" fontSize="12"/>
    <style name="SectionLabel" isBold="true" fontName="DejaVu Sans" fontSize="10"/>
    <style name="Header" isBold="true" fontName="DejaVu Sans" fontSize="9"/>
    <style name="Body" fontName="DejaVu Sans" fontSize="9"/>
    <style name="Small" fontName="DejaVu Sans" fontSize="8"/>
    <style name="Note" isItalic="true" fontName="DejaVu Sans" fontSize="7"/>

    <parameter name="ENTITY_ID" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT
                je.entry_number,
                je.entry_date,
                je.status,
                je.description,
                je.total_debit,
                je.total_credit,
                jel.line_number,
                jel.account_code,
                jel.account_name,
                jel.debit,
                jel.credit,
                jel.description AS line_description
            FROM journal_entries je
            JOIN journal_entry_lines jel ON jel.journal_entry_id = je.id
            WHERE je.id = $P{ENTITY_ID}::uuid
            ORDER BY jel.line_number
        ]]>
    </queryString>

    <field name="entry_number" class="java.lang.String"/>
    <field name="entry_date" class="java.time.LocalDate"/>
    <field name="status" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="total_debit" class="java.math.BigDecimal"/>
    <field name="total_credit" class="java.math.BigDecimal"/>
    <field name="line_number" class="java.lang.Integer"/>
    <field name="account_code" class="java.lang.String"/>
    <field name="account_name" class="java.lang.String"/>
    <field name="debit" class="java.math.BigDecimal"/>
    <field name="credit" class="java.math.BigDecimal"/>
    <field name="line_description" class="java.lang.String"/>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="515" height="30"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[JOURNAL ENTRY]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="515" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Entry #: " + $F{entry_number}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="60" width="515" height="1"/>
                <box>
                    <bottomPen lineWidth="1.0" lineColor="#000000"/>
                </box>
                <text><![CDATA[]]></text>
            </staticText>
        </band>
    </title>

    <pageHeader>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="100" height="15"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Date:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="0" width="200" height="15"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{entry_date} != null ? $F{entry_date}.toString() : ""]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="15" width="100" height="15"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Description:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="15" width="415" height="15"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="80" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#999999"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Account Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="180" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#999999"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Account Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="260" y="0" width="120" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#999999"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement x="380" y="0" width="65" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#999999"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Debit]]></text>
            </staticText>
            <staticText>
                <reportElement x="445" y="0" width="70" height="25" mode="Opaque" backcolor="#2C3E50" forecolor="#FFFFFF"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#999999"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Credit]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Small" x="0" y="0" width="80" height="25"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{account_code}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Small" x="80" y="0" width="180" height="25"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{account_name}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true"   >
            <reportElement style="Small" x="260" y="0" width="120" height="25"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{line_description}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" pattern="Rp #,##0">
            <reportElement style="Small" x="380" y="0" width="65" height="25"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{debit}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" pattern="Rp #,##0">
            <reportElement style="Small" x="445" y="0" width="70" height="25"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{credit}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <columnFooter>
        <band height="30">
            <staticText>
                <reportElement x="0" y="5" width="515" height="1"/>
                <box>
                    <topPen lineWidth="1.0" lineColor="#000000"/>
                </box>
                <text><![CDATA[]]></text>
            </staticText>
            <staticText>
                <reportElement x="260" y="10" width="120" height="15"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Totals:]]></text>
            </staticText>
            <textField pattern="Rp #,##0">
                <reportElement x="380" y="10" width="65" height="15"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{total_debit}]]></textFieldExpression>
            </textField>
            <textField pattern="Rp #,##0">
                <reportElement x="445" y="10" width="70" height="15"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{total_credit}]]></textFieldExpression>
            </textField>
        </band>
    </columnFooter>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="0" y="10" width="515" height="15"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
